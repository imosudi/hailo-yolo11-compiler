# ==============================================================================
# hailo-yolo11-compiler Environment Configuration
# ==============================================================================

# Project & Execution
YOLO_HAILO_CONFIG=config/config.yaml
YOLO_HAILO_RUN_ID=
YOLO_HAILO_EXECUTION_MODE=auto      # auto | portable | hailo_compile | hailo_runtime
YOLO_HAILO_DRY_RUN=false
YOLO_HAILO_FORCE=false
YOLO_HAILO_RESUME=false
YOLO_HAILO_VERBOSE=false
YOLO_HAILO_SEED=42

# Model & Training
YOLO_HAILO_MODEL_SOURCE=yolo11n.pt
YOLO_HAILO_MODEL_VARIANT=n          # n | s | m | l | x | custom
YOLO_HAILO_MODEL_TASK=detect
YOLO_HAILO_DATASET_YAML=data/dataset.yaml
YOLO_HAILO_DEVICE=auto              # auto | cpu | 0 | 0,1
YOLO_HAILO_EPOCHS=100
YOLO_HAILO_IMGSZ=640
YOLO_HAILO_BATCH=16

# Calibration
YOLO_HAILO_CALIB_SOURCE=train       # train | custom
YOLO_HAILO_CALIB_COUNT=200
YOLO_HAILO_CALIB_SEED=42

# Hailo DFC & Hardware
YOLO_HAILO_TARGET=hailo8l
YOLO_HAILO_SDK_MODE=auto            # auto | sdk | cli
YOLO_HAILO_REQUIRE_HARDWARE=false
HAILO_SDK_PATH=/opt/hailo
HAILORT_PATH=/usr/lib/hailort

# Accuracy Gates
YOLO_HAILO_MAP50_MAX_DROP=0.02
YOLO_HAILO_MAP5095_MAX_DROP=0.02

# Paths
YOLO_HAILO_ARTIFACTS_ROOT=./artifacts
